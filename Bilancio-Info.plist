<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- bilancio://callback: ritorno dal login della banca, tramite la pagina ponte docs/callback (GitHub Pages) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>it.bilanciopersonale.callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bilancio</string>
			</array>
		</dict>
	</array>
	<!-- "Apri con Bilancio" per estratti conto CSV / PDF -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Estratto conto</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.plain-text</string>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<!-- I file aperti con "Apri con Bilancio" (estratti conto) si leggono dove sono, senza copiarli dentro l'app.
	     La cartella dell'app NON deve comparire in "File > Sul mio iPhone": lì i backup locali, che sono in chiaro,
	     si leggerebbero senza passare da Face ID. Per mostrarla servirebbe anche UIFileSharingEnabled: manca apposta. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Commit da cui è compilata l'app (lo passa installa.sh): serve ad "Aggiorna app" -->
	<key>BilancioCommit</key>
	<string>$(BILANCIO_COMMIT)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
