<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Aggiornamento dei conti in background (Enable Banking) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>bilancio.sync</string>
	</array>
	<!-- "Apri con Bilancio" per estratti conto CSV / PDF -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Estratto conto</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.plain-text</string>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<!-- I backup finiscono in "File > Sul mio iPhone > Bilancio": per mostrare la cartella servono
	     sia LSSupportsOpeningDocumentsInPlace sia UIFileSharingEnabled -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Commit da cui è compilata l'app (lo passa installa.sh): serve ad "Aggiorna app" -->
	<key>BilancioCommit</key>
	<string>$(BILANCIO_COMMIT)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
