    "Hai %@ di spese detraibili (%@): mettile nel 730, valgono circa %@ di detrazione (19%% oltre la franchigia di %@).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "Hai %1$@ di spese detraibili (%2$@): mettile nel 730, valgono circa %3$@ di detrazione (19%% oltre la franchigia di 129,11 €)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %@ in tax-deductible expenses (%@): add them to your 730 tax return, they're worth about %@ in tax credit (19%% above the %@ threshold)."
          }
        }
      }
    },
    "Hai %@ di spese detraibili (%@): sotto la franchigia di %@ non danno detrazione, ma conserva gli scontrini.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "Hai %1$@ di spese detraibili (%2$@): sotto la franchigia di 129,11 € non danno detrazione, ma conserva gli scontrini."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %@ in tax-deductible expenses (%@): below the %@ threshold they give no tax credit, but keep the receipts."
          }
        }
      }
    },
    "Hai versato %@ su %@: fino a %@ sono deducibili, quindi ricordati di metterli nel 730.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "Hai versato %1$@ su %2$@: fino a 5.164,57 € sono deducibili, quindi ricordati di metterli nel 730."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You paid %@ into %@: up to %@ is deductible, so remember to include it in your 730 tax return."
          }
        }
      }
    },
    "Hai versato %@ su %@: solo %@ sono deducibili, la parte in più no.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "Hai versato %1$@ su %2$@: solo 5.164,57 € sono deducibili, la parte in più no."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You paid %@ into %@: only %@ is deductible, the excess isn't."
          }
        }
      }
    },
    "I versamenti sono deducibili fino a %@ l'anno: il dettaglio mostra quanto hai già versato.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deposits are deductible up to %@ a year: the detail screen shows how much you've already paid in."
